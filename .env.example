# Copie para .env (opcional). Todos os valores têm padrão seguro para desenvolvimento.
PORT=3000
# Caminho do arquivo SQLite
COCHEF_DB=dados/cochef.db
# Segredo de assinatura dos tokens (mínimo 32 caracteres). Se ausente, um segredo
# aleatório é gerado e guardado em dados/.segredo-jwt na primeira execução.
# COCHEF_JWT_SEGREDO=
# Fuso usado para calcular "hoje" (validade, escala)
COCHEF_FUSO=America/Sao_Paulo
# Custo do scrypt (log2 de N). 17 = recomendação OWASP.
COCHEF_SCRYPT_LOGN=17
